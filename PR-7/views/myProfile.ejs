<%- include('header') %>

<div class="page-wrapper">
  <div class="container-fluid py-4">

    <div class="row justify-content-center">
      <div class="col-lg-7 col-md-9">

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

          <!-- Profile Header -->
          <div class="bg-primary text-white text-center p-4">

            <% if(user.profileImage && user.profileImage !== "") { %>
              <img src="/<%= user.profileImage %>"
                   class="rounded-circle border border-4 border-white shadow"
                   width="120"
                   height="120"
                   style="object-fit:cover;">
            <% } else { %>
              <img src="/assets/images/users/1.jpg"
                   class="rounded-circle border border-4 border-white shadow"
                   width="120"
                   height="120"
                   style="object-fit:cover;">
            <% } %>

            <h3 class="mt-3 mb-0 fw-bold">
              <%= user.firstname %> <%= user.lastname %>
            </h3>

            <small class="opacity-75">
              <%= user.email %>
            </small>

          </div>


          <!-- Profile Details -->
          <div class="card-body p-4">

            <div class="row g-3">

              <div class="col-md-6">
                <div class="p-3 bg-light rounded-3">
                  <small class="text-muted">First Name</small>
                  <h6 class="mb-0 fw-semibold"><%= user.firstname %></h6>
                </div>
              </div>

              <div class="col-md-6">
                <div class="p-3 bg-light rounded-3">
                  <small class="text-muted">Last Name</small>
                  <h6 class="mb-0 fw-semibold"><%= user.lastname %></h6>
                </div>
              </div>

              <div class="col-md-6">
                <div class="p-3 bg-light rounded-3">
                  <small class="text-muted">Gender</small>
                  <h6 class="mb-0 fw-semibold"><%= user.gender %></h6>
                </div>
              </div>

              <div class="col-md-6">
                <div class="p-3 bg-light rounded-3">
                  <small class="text-muted">Phone Number</small>
                  <h6 class="mb-0 fw-semibold"><%= user.mobileNo %></h6>
                </div>
              </div>

            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-5 mt-4">

              <a href="/admin/editAdmin/<%= user._id %>"
                 class="btn btn-primary px-8 rounded-pill">
                 Edit Profile
              </a>

              <a href="/changePassword"
                 class="btn btn-warning px-8 rounded-pill text-white">
                 Change Password
              </a>

            </div>

          </div>

        </div>

      </div>
    </div>

  </div>
</div>

<%- include('footer') %>