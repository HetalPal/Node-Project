<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Book Store</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #eef2f5;
      margin: 0;
      padding: 20px;
    }

    h2 {
      color: #333;
      margin-bottom: 15px;
    }

    table {
      width: 90%;
      background: #ffffff;
      border-collapse: collapse;
      margin-bottom: 30px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 10px;
      text-align: center;
    }

    th {
      background-color: #2c3e50;
      color: #ffffff;
    }

    tr:nth-child(even) {
      background-color: #f8f9fa;
    }

    input[type="text"],
    input[type="file"] {
      width: 90%;
      padding: 6px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    button {
      padding: 8px 20px;
      background-color: #27ae60;
      border: none;
      color: white;
      font-size: 15px;
      border-radius: 4px;
      cursor: pointer;
    }

    button:hover {
      background-color: #219150;
    }

    img {
      width: 60px;
      height: 80px;
      object-fit: cover;
      border-radius: 4px;
    }

    a {
      padding: 6px 12px;
      background-color: #3498db;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      font-size: 14px;
    }

    a:hover {
      background-color: #2980b9;
    }

    .delete {
      background-color: #e74c3c;
    }

    .delete:hover {
      background-color: #c0392b;
    }
  </style>
</head>

<body>
  <center>
    <h2>Book Store</h2>
    <form action="/add-book" method="post" enctype="multipart/form-data">
      <table>
        <tr>
          <th>Book Name</th>
          <td><input type="text" name="bookname"></td>
        </tr>
        <tr>
          <th>Author Name</th>
          <td><input type="text" name="authorname"></td>
        </tr>
        <tr>
          <th>Price</th>
          <td><input type="text" name="price"></td>
        </tr>
        <tr>
          <th>Category</th>
          <td><input type="text" name="category"></td>
        </tr>
        <tr>
          <th>Book Number</th>
          <td><input type="text" name="bookid"></td>
        </tr>
        <tr>
          <th>Language</th>
          <td><input type="text" name="language"></td>
        </tr>
        <tr>
          <th>Pages</th>
          <td><input type="text" name="pages"></td>
        </tr>
        <tr>
          <th>Quantity</th>
          <td><input type="text" name="quantity"></td>
        </tr>
        <tr>
          <th>Image</th>
          <td><input type="file" name="img"></td>
        </tr>
        <tr>
          <th colspan="2">
            <button type="submit">Add Book</button>
          </th>
        </tr>
      </table>
    </form>

    <h2>All Books</h2>
    <table>
      <tr>
        <th>Book No</th>
        <th>Image</th>
        <th>Name</th>
        <th>Author</th>
        <th>Price</th>
        <th>Category</th>
        <th>Language</th>
        <th>Qty</th>
        <th>Action</th>
      </tr>

      <% books.forEach(book=> { %>
        <tr>
          <td>
            <%= book.bookid %>
          </td>
          <td><img src="/uploads/<%= book.img %>"></td>
          <td>
            <%= book.bookname %>
          </td>
          <td>
            <%= book.authorname %>
          </td>
          <td>₹ <%= book.price %>
          </td>
          <td>
            <%= book.category %>
          </td>
          <td>
            <%= book.language %>
          </td>
          <td>
            <%= book.quantity %>
          </td>
          <td>
            <a href="/edit/<%= book._id %>">Edit</a>
            <a href="/delete/<%= book._id %>" class="delete">Delete</a>
          </td>
        </tr>
        <% }) %>
    </table>
  </center>
</body>

</html>