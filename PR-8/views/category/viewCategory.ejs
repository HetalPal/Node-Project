<%- include('../header') %>

    <div class="page-wrapper">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">

                    <h4 class="card-title">Category List</h4>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>SR NO</th>
                                <th>Name</th>
                                <th>Image</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% categories.forEach((category,i)=>{ %>
                                <tr>
                                    <td>
                                        <%= i+1 %>
                                    </td>
                                    <td>
                                        <%= category.categoryname %>
                                    </td>
                                    <td>
                                        <img src="<%= category.categoryImg %>" width="70">
                                    </td>

                                    <td>
                                        <a href="/category/edit-category/<%= category._id %>"
                                            class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a href="/category/delete-category/<%= category._id %>"
                                            class="btn btn-danger btn-sm">
                                            Delete
                                        </a>
                                    </td>
                                </tr>

                                <% }) %>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>