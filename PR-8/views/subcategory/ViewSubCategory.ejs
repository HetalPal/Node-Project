<%- include('../header') %>

    <div class="page-wrapper">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">

                    <h4 class="card-title">Sub Category List</h4>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>SR NO</th>
                                <th>SubCategory Name</th>
                                <th>Image</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% subcategories.forEach((sub,i)=>{ %>
                                <tr>
                                    <td>
                                        <%= i+1 %>
                                    </td>
                                    <td>
                                        <%= sub.categoryId ? sub.categoryId.categoryname : "No Category" %>
                                    </td>
                                    <td>
                                        <%= sub.subCategoryName %>
                                    </td>
                                    <td>
                                        <a href="/subcategory/edit-subcategory/<%= sub._id %>"
                                            class="btn btn-warning">Edit</a>
                                        <a href="/subcategory/delete-subcategory/<%= sub._id %>"
                                            class="btn btn-danger">Delete</a>
                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>